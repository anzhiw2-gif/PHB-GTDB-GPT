manifest {
    name = 'anzhiw2-gif/PHB-GTDB-GPT'
    description = 'Family-resolved PHB/PHA depolymerase analysis in GTDB R232'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.10.0'
}

params {
    project_dir = projectDir
    entry = 'P01'
    outdir = "${projectDir}/08_reports"
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 1
}

profiles {
    test {
        params.entry = 'test'
        process.cpus = 1
        process.memory = '1 GB'
        process.time = '30m'
    }

    slurm {
        process.executor = 'slurm'
        process.queue = 'normal'
        process.errorStrategy = 'retry'
        process.maxRetries = 2
    }
}
